# SurSadhana backend configuration — copy to .env and fill in real values.
# NEVER commit .env. These secrets are only read by the Express server.

# Claude API (AI Vocal Tutor). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional override; defaults to claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5

# YouTube Data API v3 (Video Library live search). https://console.cloud.google.com
YOUTUBE_API_KEY=your-youtube-data-api-key-here

# Server
PORT=8787
# Requests per 15 minutes per IP for the AI tutor
TUTOR_RATE_LIMIT=40

# Where the optional account-sync database (SQLite, built into Node) is stored
DATA_DIR=./data
# Where self-hosted client crash reports are written (JSON lines)
LOG_DIR=./logs
